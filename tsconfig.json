{
    "compilerOptions": {
        "target": "es2015",
        "module": "node16",
        "declaration": true,
        "rootDir": "./lib",
        "outDir": "./dist",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "moduleResolution": "node16",
        "esModuleInterop": true,
        "types": ["node"]
    },
    "include": [
        "lib/**/*"
    ]
}
